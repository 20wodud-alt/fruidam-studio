# Optional: app settings also accept these keys without an environment file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Prepared integration only; live Nongsaro lookup is not connected yet.
NONGSARO_API_KEY=

# Server-only. Never use NEXT_PUBLIC_ for a Supabase secret/service_role key.
# Until the Supabase project and migration are ready, the app stays local.
FRUIDAM_STORAGE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative (prefer SUPABASE_SECRET_KEY when available):
# SUPABASE_SERVICE_ROLE_KEY=

# One-time migration only. Do not copy the management token into browser code.
# SUPABASE_ACCESS_TOKEN=

# Deployment: use supabase for persistent files/preferences. Keys stay in env.
# Local default is local; VERCEL defaults to supabase.
# FRUIDAM_ASSET_STORAGE=supabase
# FRUIDAM_SETTINGS_STORAGE=supabase
